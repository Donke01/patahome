# PataHome — environment variables
# Copy to `.env` for local dev, or paste each key into Railway → Variables for prod.
# Never commit real secrets. This file is a template only.

# ---- Core ---------------------------------------------------------------
# Port to listen on. Railway injects this automatically — leave unset in prod.
PORT=3000

# Absolute path to the SQLite database file.
# Prod: /data/patahome.db  (must be on a Railway Volume)
# Dev:  ./patahome.db      (or leave unset — defaults next to server.js)
DB_PATH=./patahome.db

# Long random string. Rotating this invalidates every existing session.
JWT_SECRET=change-me-to-a-long-random-string

# Public origin used in emails, canonical URLs, og:url tags, etc.
# Prod: https://patahome.co.ke
# Dev:  http://localhost:3000
BASE_URL=http://localhost:3000

# ---- Admin bootstrap (seed.js reads these once at first boot) ----------
ADMIN_PHONE=0700000001
ADMIN_PASSWORD=change-me
SEED_DEMO=0

# ---- Resend (email) -----------------------------------------------------
# See docs/services/resend.md
RESEND_API_KEY=
MAIL_FROM=info@patahome.co.ke

# ---- SMTP fallback (local dev only — Railway blocks these ports) --------
# Leave blank in prod so lib.js uses Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Cloudinary (photos + KYC docs) -------------------------------------
# See docs/services/cloudinary.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google Sign-In -----------------------------------------------------
# See docs/services/google-signin.md
GOOGLE_CLIENT_ID=

# ---- Infobip (SMS one-time codes) ---------------------------------------
# See docs/services/infobip.md
# Both KEY and BASE_URL must be set before SMS verification switches on.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
SMS_SENDER=PataHome
# Kill switch for phone verification — set to "off" while a sender ID is still
# awaiting operator approval. Phone signup keeps working, no codes are sent,
# and posting a listing no longer requires a verified phone.
# Remove the variable (or set anything else) to turn verification back on.
PHONE_VERIFY=
